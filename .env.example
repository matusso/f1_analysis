# Copy to `.env` and adjust. All variables are optional; defaults are in
# src/f1_analysis/config.py. Variables use the F1_ prefix.

# Where FastF1 caches downloaded session data.
F1_CACHE_DIR=.f1cache

# Presentation
F1_APP_TITLE=F1 Analysis
F1_APP_LAYOUT=wide

# Grafana export backend (planned; see src/f1_analysis/exporters/grafana.py).
# F1_GRAFANA_URL=https://grafana.example.com
# F1_GRAFANA_API_KEY=
# F1_GRAFANA_ORG_ID=1
